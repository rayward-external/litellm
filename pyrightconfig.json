{
    "include": ["litellm", "litellm_cli"],
    "ignore": [],
    "exclude": ["**/node_modules", "**/__pycache__", "tests/e2e/claude_code", "tests/e2e_harness/claude_code", "tests/e2e/ui", "litellm/types/utils.py", "litellm/proxy/_types.py"],
    "extraPaths": ["litellm-proxy-extras"],
    "executionEnvironments": [
        {
            "root": "tests/e2e_harness",
            "extraPaths": [
                "tests/e2e",
                "tests/e2e/batches",
                "tests/e2e/guardrails",
                "tests/e2e/perf",
                "tests/e2e/logging",
                "litellm-proxy-extras"
            ]
        }
    ],
    "pythonVersion": "3.12",
    "typeCheckingMode": "strict",
    "enableTypeIgnoreComments": false,
    "reportMissingImports": false,
    "reportPrivateImportUsage": false,
    "reportExplicitAny": "error",
    "reportAny": "error"
}
